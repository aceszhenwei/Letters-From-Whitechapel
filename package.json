{
  "name": "letters-from-whitechapel",
  "version": "1.0.0",
  "private": true,
  "description": "Browser based version of the Letters From Whitechapel board game",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:regression": "node --test \"test/regression/**/*.test.js\"",
    "test:smoke": "node tools/tiers/run-tier.js smoke",
    "eval:medium": "node tools/tiers/run-tier.js medium",
    "research:full": "node tools/tiers/run-tier.js full",
    "research:import": "node tools/game-log/import.js",
    "playtests": "node tools/playtests/dataset.js",
    "playtests:add": "node tools/playtests/dataset.js --add",
    "playtests:intake": "node tools/playtests/intake.js",
    "playtests:worker-check": "node worker/scripts/deploy.mjs --dry-run",
    "site": "node tools/site/build.js",
    "tier": "node tools/tiers/run-tier.js"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0"
  }
}
